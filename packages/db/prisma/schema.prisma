// packages/db/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Perfil {
  MASTER
  ADMIN
  OPERADOR
}

enum Categoria {
  MOT
  FRE
  TRA
  ELE
  SUS
  PNE
  ACC
  OUT
}

enum Unidade {
  UN
  CX
  PC
  KG
  L
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
  AJUSTE
  PERDA
  DEVOLUCAO
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO
}

// ─── Usuario ──────────────────────────────────────────────────────────────────

model Usuario {
  id               Int       @id @default(autoincrement())
  nome             String
  email            String    @unique
  senhaHash        String    @map("senha_hash")
  perfil           Perfil
  ativo            Boolean   @default(true)
  tentativasFalhas Int       @default(0) @map("tentativas_falhas")
  bloqueadoAte     DateTime? @map("bloqueado_ate")
  refreshTokenHash String?   @map("refresh_token_hash")
  criadoEm        DateTime  @default(now()) @map("criado_em")
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em")

  movimentacoes    Movimentacao[]
  vendas           Venda[]
  vendasCanceladas Venda[] @relation("VendaCancelamento")

  @@index([email])
  @@map("usuario")
}

// ─── Fornecedor ───────────────────────────────────────────────────────────────

model Fornecedor {
  id           Int      @id @default(autoincrement())
  razaoSocial  String   @map("razao_social")
  cnpj         String   @unique
  telefone     String?
  email        String?
  contato      String?
  ativo        Boolean  @default(true)
  criadoEm    DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  movimentacoes Movimentacao[]

  @@index([cnpj])
  @@index([ativo])
  @@map("fornecedor")
}

// ─── Produto ──────────────────────────────────────────────────────────────────

model Produto {
  id            Int       @id @default(autoincrement())
  sku           String    @unique
  nome          String
  descricao     String?
  categoria     Categoria
  unidade       Unidade
  marca         String?
  aplicacao     String?
  localizacao   String?
  fotoUrl       String?   @map("foto_url")
  estoqueMinimo Int       @default(0) @map("estoque_minimo")
  estoqueAtual  Int       @default(0) @map("estoque_atual")
  custoMedio    Decimal   @default(0) @db.Decimal(10, 2) @map("custo_medio")
  precoVenda    Decimal?  @db.Decimal(10, 2) @map("preco_venda")
  ativo         Boolean   @default(true)
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  codigosBarras Codigo[]
  movimentacoes Movimentacao[]
  itensVenda    ItemVenda[]

  @@index([nome])
  @@index([categoria])
  @@index([ativo])
  @@index([categoria, ativo])
  @@map("produto")
}

// ─── Codigo ───────────────────────────────────────────────────────────────────

model Codigo {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique
  produtoId Int      @map("produto_id")
  produto   Produto  @relation(fields: [produtoId], references: [id])
  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([codigo])
  @@index([produtoId])
  @@map("codigo")
}

// ─── SkuSequencia ─────────────────────────────────────────────────────────────

model SkuSequencia {
  categoria Categoria @id
  proximo   Int       @default(1)

  @@map("sku_sequencia")
}

// ─── Movimentacao ─────────────────────────────────────────────────────────────

model Movimentacao {
  id            Int              @id @default(autoincrement())
  tipo          TipoMovimentacao
  quantidade    Int
  custoUnitario Decimal          @db.Decimal(10, 2) @map("custo_unitario")
  observacao    String?

  produtoId  Int        @map("produto_id")
  produto    Produto    @relation(fields: [produtoId], references: [id])

  usuarioId  Int        @map("usuario_id")
  usuario    Usuario    @relation(fields: [usuarioId], references: [id])

  fornecedorId Int?       @map("fornecedor_id")
  fornecedor   Fornecedor? @relation(fields: [fornecedorId], references: [id])

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([produtoId])
  @@index([usuarioId])
  @@index([tipo])
  @@index([criadoEm])
  @@index([produtoId, tipo, criadoEm])
  @@index([tipo, criadoEm])
  @@map("movimentacao")
}

// ─── VendaSequencia ───────────────────────────────────────────────────────────

model VendaSequencia {
  id      Int @id @default(1)
  proximo Int @default(1)

  @@map("venda_sequencia")
}

// ─── Venda ────────────────────────────────────────────────────────────────────

model Venda {
  id                 Int            @id @default(autoincrement())
  numero             String         @unique
  clienteNome        String?        @map("cliente_nome")
  clienteTelefone    String?        @map("cliente_telefone")
  clienteCpf         String?        @map("cliente_cpf")
  formaPagamento     FormaPagamento @map("forma_pagamento")
  subtotal           Decimal        @db.Decimal(10, 2)
  descontoPercentual Decimal        @default(0) @db.Decimal(5, 2) @map("desconto_percentual")
  descontoAplicado   Decimal        @default(0) @db.Decimal(10, 2) @map("desconto_aplicado")
  total              Decimal        @db.Decimal(10, 2)
  observacao         String?
  usuarioId          Int            @map("usuario_id")
  usuario            Usuario        @relation(fields: [usuarioId], references: [id])
  itens              ItemVenda[]
  criadoEm          DateTime       @default(now()) @map("criado_em")
  canceladoEm       DateTime?      @map("cancelado_em")
  canceladoPorId    Int?           @map("cancelado_por_id")
  canceladoPor      Usuario?       @relation("VendaCancelamento", fields: [canceladoPorId], references: [id])

  @@index([criadoEm])
  @@index([usuarioId])
  @@index([formaPagamento])
  @@map("venda")
}

// ─── ItemVenda ────────────────────────────────────────────────────────────────

model ItemVenda {
  id            Int     @id @default(autoincrement())
  vendaId       Int     @map("venda_id")
  venda         Venda   @relation(fields: [vendaId], references: [id])
  produtoId     Int     @map("produto_id")
  produto       Produto @relation(fields: [produtoId], references: [id])
  quantidade    Int
  precoUnitario Decimal @db.Decimal(10, 2) @map("preco_unitario")
  custoUnitario Decimal @db.Decimal(10, 2) @map("custo_unitario")
  subtotal      Decimal @db.Decimal(10, 2)

  @@index([vendaId])
  @@index([produtoId])
  @@map("item_venda")
}
